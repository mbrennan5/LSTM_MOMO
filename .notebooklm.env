# NotebookLM Skill Configuration — LSTM_MOMO / Sovereign Titan
# Copied to ~/.claude/skills/notebooklm/.env by setup_notebooklm.sh
#
# Full option reference:
# https://github.com/PleasePrompto/notebooklm-skill

# Default notebook — all queries go here unless --notebook-id is specified
DEFAULT_NOTEBOOK_ID=4ed28b19-7ba3-44b7-a1f9-cba4fa452fdf

# Browser visibility (set HEADLESS=false for debugging auth issues)
HEADLESS=true
SHOW_BROWSER=false

# Human-like typing behavior (reduces bot-detection risk)
STEALTH_ENABLED=true
TYPING_WPM_MIN=160
TYPING_WPM_MAX=240
